<block>
  <view wx:if="{{hidden}}" class="ai-fab__dot" bindtap="restoreFab"></view>
  <view wx:else class="ai-fab" style="{{useCustomPos ? ('left:' + posX + 'rpx;top:' + posY + 'rpx;right:auto;bottom:auto') : ''}}" bindtap="openAssistant" bindlongpress="toggleHidden" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <view class="ai-fab__halo"></view>
    <view class="ai-fab__button">
      <image class="ai-fab__icon" src="/images/ai-fab/assistant-orbit.svg" mode="aspectFit" />
    </view>
  </view>
</block>
