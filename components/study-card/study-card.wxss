.study-card {
  padding: 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.study-card__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.study-card__meta-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.study-card__stage,
.study-card__keyword {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.study-card__action {
  flex-shrink: 0;
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.study-card__title {
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.study-card__summary {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.study-card__keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.study-card__keyword {
  background: #f8fafc;
  color: #475569;
}
