.favorite {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 64rpx;
  padding: 0;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.favorite::after {
  border: 0;
}

.favorite--active {
  border-color: #0f766e;
  background: #0f766e;
  color: #ffffff;
}
