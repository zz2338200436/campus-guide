.empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.empty__status-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #eff6ff;
  color: #0369a1;
  font-size: 24rpx;
  font-weight: 800;
}

.empty__status {
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty__title {
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.4;
}

.empty__desc {
  max-width: 600rpx;
  margin-top: 10rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.65;
}

.empty__btn {
  margin-top: 24rpx;
  min-width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  border: 0;
  border-radius: 14rpx;
  background: #0369a1;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}
