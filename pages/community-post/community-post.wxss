.page {
  padding-bottom: 184rpx;
}

.post-card {
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.post-hero__label,
.post-section__title,
.post-tags__label,
.post-location__label {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.post-hero__title {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.38;
}

.post-mode-note {
  margin-top: 8rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.55;
}

.post-switch,
.post-status-switch {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.post-switch__item,
.post-status-switch__item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 110rpx;
  height: 54rpx;
  padding: 0 16rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.post-switch__item--active,
.post-status-switch__item--active {
  border-color: #0f766e;
  background: #ecfdf5;
  font-weight: 800;
}

.post-section {
  position: relative;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.marketplace-fields {
  background: #f0fdfa;
}

.post-input,
.post-textarea {
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 26rpx;
  box-sizing: border-box;
}

.post-input {
  height: 72rpx;
  padding: 0 18rpx;
  line-height: 72rpx;
}

.post-textarea-wrap {
  margin-top: 14rpx;
  height: 240rpx;
  overflow: hidden;
  border-radius: 8rpx;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
}

.post-textarea {
  width: 100%;
  height: 240rpx;
  min-height: 240rpx;
  margin-top: 0;
  padding: 18rpx;
  border: 0;
  background: transparent;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.post-submit-bar {
  margin-top: 22rpx;
  padding-bottom: 6rpx;
}

.post-submit-bar__button {
  width: 100%;
}

/* ======= 图片上传 ======= */
.post-images__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.post-images__item {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  border-radius: 8rpx;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
}

.post-images__img {
  width: 100%;
  height: 100%;
}

.post-images__remove {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 0 8rpx 0 8rpx;
  background: rgba(15, 23, 42, 0.7);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.post-images__add {
  width: 144rpx;
  height: 144rpx;
  border: 2rpx dashed #ccfbf1;
  border-radius: 8rpx;
  background: #f0fdfa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.post-images__add-icon {
  color: #0f766e;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
}

.post-images__add-text {
  color: #0f766e;
  font-size: 22rpx;
}

/* ======= 标签选择 ======= */
.post-tags__label {
  margin-bottom: 10rpx;
}

/* 标签独立成节后无需额外上边距 */

/* 独立成节后，标签不需要额外上边距 */
.post-section > .post-tags {
  margin-top: 0;
}

.post-tags__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}

.post-tag {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.4;
  transition: all 0.15s ease;
  box-sizing: border-box;
}

.post-tag--active {
  border-color: #0f766e;
  background: #ecfdf5;
  color: #0f766e;
  font-weight: 700;
}

.post-tag:active {
  opacity: 0.7;
  transform: scale(0.96);
}

/* ======= 地点选择 ======= */
.post-location__label {
  margin-bottom: 10rpx;
}

.post-location {
  margin-top: 16rpx;
}

.post-location__body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.post-location__icon {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50% 50% 50% 4rpx;
  background: #0f766e;
  transform: rotate(-45deg);
  position: relative;
}

.post-location__icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}

.post-location__text {
  flex: 1;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-location__text--placeholder {
  color: #9ca3af;
}

.post-location__arrow {
  flex-shrink: 0;
  color: #9ca3af;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

/* ======= 成色选择 & 交易状态 ======= */
.post-condition,
.post-status {
  margin-top: 14rpx;
}

.post-condition__label,
.post-status__label {
  margin-bottom: 8rpx;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

.post-condition__list,
.post-status-switch {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
