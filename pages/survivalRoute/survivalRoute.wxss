.route-hero,
.scene-panel,
.route-card,
.timeline-step,
.final-tip {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.route-hero__eyebrow,
.scene-panel__label,
.route-card__label,
.route-materials__title,
.final-tip__label,
.scene-card__question {
  color: #0369a1;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.route-hero__title {
  margin-top: 10rpx;
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.32;
}

.route-hero__desc,
.route-hero__meta,
.route-card__summary,
.final-tip__text,
.timeline-step__desc,
.timeline-step__tip {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.route-hero__meta {
  padding: 14rpx 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
  font-weight: 700;
}

.scene-panel__head,
.route-card__head,
.timeline-step__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.scene-panel__title,
.route-card__title,
.timeline-step__place {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.38;
}

.scene-panel__count,
.route-card__badge,
.timeline-step__status {
  flex-shrink: 0;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.scene-card {
  min-height: 156rpx;
  padding: 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.scene-card--active {
  border-color: #0369a1;
  background: #eff6ff;
}

.scene-card__question,
.scene-card__title,
.scene-card__desc,
.route-progress__next,
.timeline-step__service,
.timeline-step__footer,
.final-tip__text {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}

.scene-card__question {
  -webkit-line-clamp: 1;
}

.scene-card__title {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  -webkit-line-clamp: 1;
}

.scene-card__desc {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
  -webkit-line-clamp: 2;
}

.route-progress,
.route-materials {
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
}

.route-progress__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #0f172a;
  font-size: 23rpx;
  font-weight: 800;
}

.route-progress__track {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 8rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.route-progress__bar {
  height: 100%;
  border-radius: 8rpx;
  background: #0369a1;
}

.route-progress__next {
  margin-top: 12rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.5;
  -webkit-line-clamp: 2;
}

.route-materials__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.route-material {
  min-height: 40rpx;
  padding: 0 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  color: #475569;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.route-primary {
  margin-top: 18rpx;
  min-height: 70rpx;
  border-radius: 8rpx;
  background: #0369a1;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 70rpx;
  text-align: center;
}

.timeline {
  display: grid;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.timeline-step {
  display: flex;
  gap: 16rpx;
}

.timeline-step__rail {
  flex-shrink: 0;
  width: 52rpx;
}

.timeline-step__index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: #0369a1;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
}

.timeline-step__index--done {
  background: #0f766e;
}

.timeline-step__index--next {
  box-shadow: 0 0 0 8rpx rgba(3, 105, 161, 0.12);
}

.timeline-step__body {
  flex: 1;
  min-width: 0;
}

.timeline-step__status--done {
  background: #f0fdf4;
  color: #166534;
}

.timeline-step__status--next {
  background: #eff6ff;
  color: #0369a1;
}

.timeline-step__service {
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.45;
  -webkit-line-clamp: 2;
}

.timeline-step__footer {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #e5e7eb;
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
  -webkit-line-clamp: 2;
}

.final-tip__text {
  -webkit-line-clamp: 3;
}

@media (max-width: 360px) {
  .route-hero,
  .scene-panel,
  .route-card,
  .timeline-step,
  .final-tip {
    padding: 20rpx;
  }

  .scene-grid {
    grid-template-columns: 1fr;
  }

  .route-hero__title {
    font-size: 36rpx;
  }
}
