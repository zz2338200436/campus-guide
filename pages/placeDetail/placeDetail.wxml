<view class="page {{themeClass}}">
  <view class="loading-text" wx:if="{{loading}}">地点详情加载中...</view>

  <view wx:if="{{detail}}">
    <view class="detail-hero">
      <image class="detail-hero__image" wx:if="{{detail.image}}" src="{{detail.image}}" mode="aspectFill" />
      <view class="detail-hero__eyebrow">{{detail.type}}</view>
      <view class="detail-hero__title">{{detail.name}}</view>
    </view>

    <view class="detail-card">
      <view class="detail-card__head">
        <view>
          <view class="detail-card__title">地点信息</view>
          <view class="detail-card__tags">
            <text class="tag">{{detail.type}}</text>
            <text class="detail-card__time">{{detail.openTime}}</text>
          </view>
        </view>
        <favorite-btn
          id="favoriteBtn"
          type="place"
          targetId="{{detail.id}}"
          title="{{detail.name}}"
          summary="{{detail.description}}"
        />
      </view>
      <view class="detail-checkin">
        <view class="detail-checkin__body">
          <view class="detail-checkin__text">{{checkedIn ? '到访记录已更新' : '到访后可直接记录'}}</view>
        </view>
        <button class="{{checkedIn ? 'btn-secondary' : 'btn-primary'}} detail-checkin__btn" bindtap="checkInPlace">{{checkedIn ? '已完成到访' : '记录到访'}}</button>
      </view>
      <view class="detail-guide__row" wx:if="{{detail.bestFor}}">适合 {{detail.bestFor}} · {{detail.bestTime}}</view>
      <view class="detail-guide__row" wx:if="{{detail.nearby.length}}">周边：{{detail.nearby.join('、')}}</view>
    </view>

    <view class="detail-services card" wx:if="{{relatedServices.length}}">
      <view class="detail-card__title">这里能办什么</view>
      <view class="detail-service" wx:for="{{relatedServices}}" wx:key="id">
        <view class="detail-service__head">
          <view class="detail-service__title">{{item.title}}</view>
          <view class="detail-service__desc">{{item.content}}</view>
        </view>
        <view class="detail-service__footer">
          <view
            class="detail-service__call"
            data-phone="{{item.phone}}"
            bindtap="callServicePhone"
          >
            {{item.phone}}
          </view>
        </view>
      </view>
    </view>

    <view class="detail-next card" wx:if="{{relatedPlaces.length}}">
      <view class="detail-card__title">建议下一站</view>
      <view
        wx:for="{{relatedPlaces}}"
        wx:key="id"
        class="link-row"
        data-id="{{item.id}}"
        bindtap="openRelated"
      >
        <view>
          <view class="link-row__title">{{item.name}}</view>
          <view class="link-row__meta">{{item.tagline}}</view>
        </view>
        <view class="link-row__action">查看</view>
      </view>
    </view>

    <view class="detail-actionbar">
      <button class="detail-actionbar__primary" bindtap="startNavigation">开始导航</button>
    </view>
  </view>

  <empty-state
    wx:if="{{!loading && !detail}}"
    statusText="地点未找到"
    title="内容不存在"
    description="请返回导览页重新选择"
    buttonText="返回导览"
    url="/pages/map/map"
  />
</view>
