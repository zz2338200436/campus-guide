.page {
  padding-bottom: 156rpx;
}

.detail-hero,
.detail-card,
.detail-services,
.detail-next {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.detail-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.detail-hero__image {
  width: 100%;
  height: 300rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  background: #e5e7eb;
}

.detail-hero__title {
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.detail-checkin__text,
.detail-guide__row,
.detail-service__desc {
  margin-top: 10rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-guide__row,
.detail-service__desc {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}

.detail-service__desc {
  -webkit-line-clamp: 2;
}

.detail-card__head,
.detail-service__footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-card__title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.detail-card__tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.detail-card__time {
  color: #334155;
  font-size: 26rpx;
  line-height: 1.4;
}

.detail-checkin,
.coordinate-trust,
.detail-guide__row {
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
}

.detail-checkin {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx;
}

.detail-checkin__body {
  flex: 1;
  min-width: 0;
}

.detail-checkin__text {
  margin-top: 0;
}

.detail-checkin__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 168rpx;
  height: 68rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  line-height: 1;
}

.detail-checkin__btn::after {
  border: 0;
}

.detail-guide__row {
  padding: 14rpx 16rpx;
}

.coordinate-trust {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
}

.coordinate-trust--review {
  border-color: #fed7aa;
  background: #fff7ed;
}

.coordinate-trust__head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.coordinate-trust__label,
.coordinate-trust__review {
  min-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.coordinate-trust--review .coordinate-trust__label,
.coordinate-trust--review .coordinate-trust__review {
  background: #ffedd5;
  color: #9a3412;
}

.coordinate-trust__source {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.coordinate-trust__desc {
  margin-top: 8rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-service {
  padding: 20rpx 0;
  border-top: 1rpx solid #e5e7eb;
}

.detail-service:first-of-type {
  border-top: 0;
  padding-top: 16rpx;
}

.detail-service__title {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.detail-service__head {
  margin-bottom: 8rpx;
}

.detail-service__desc {
  margin-top: 6rpx;
}

.detail-service__footer {
  margin-top: 12rpx;
  justify-content: flex-end;
}

.detail-service__call {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.detail-actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  box-shadow: 0 -10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.detail-actionbar__primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-actionbar__primary::after {
  border: 0;
}

@media (max-width: 360px) {
  .detail-hero,
  .detail-card,
  .detail-services,
  .detail-next {
    padding: 20rpx;
  }

  .detail-checkin,
  .detail-service__footer {
    align-items: stretch;
    flex-direction: column;
  }

  .detail-checkin__btn,
  .detail-service__call {
    width: 100%;
  }
}
