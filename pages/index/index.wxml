<view class="page home-page {{themeClass}}">
  <view class="skeleton-panel card" wx:if="{{loading}}">
    <view class="skeleton-line skeleton-line--hero"></view><view class="skeleton-grid"><view class="skeleton-box"></view><view class="skeleton-box"></view><view class="skeleton-box"></view></view><view class="skeleton-line"></view>
  </view>

  <view class="home-hero">
    <swiper class="home-hero-swiper" autoplay circular interval="4200" duration="500" wx:if="{{banners.length}}">
      <swiper-item wx:for="{{banners}}" wx:key="id"><view class="home-hero-slide"><image class="home-hero-slide__image" src="{{item.image}}" mode="aspectFill" /><view class="home-hero-slide__shade"></view><view class="home-hero-slide__caption"><text class="home-hero__eyebrow">Campus Guide</text><text class="home-hero__title">广州应用科技学院肇庆校区</text><text class="home-hero__desc">今天先去哪，地图、服务、校园圈都在这里</text></view></view></swiper-item>
    </swiper>
  </view>

  <view class="home-next card" wx:if="{{nextRoutePlace}}" data-id="{{nextRoutePlace.id}}" bindtap="openPlaceDetail">
    <view class="home-next__body"><text class="home-next__label">推荐下一站</text><text class="home-next__title">{{nextRoutePlace.name}}</text><text class="home-next__desc">{{nextRoutePlace.guide || nextRoutePlace.desc}}</text></view>
    <view class="home-next__action">去看看</view>
  </view>

  <view class="section">
    <view class="section-title"><text class="section-title__text">常用入口</text><text class="section-title__action" data-url="/pages/service/service" bindtap="openQuickAction">全部服务</text></view>
    <view class="home-core-grid">
      <view wx:for="{{coreActions}}" wx:key="id" class="home-core-action card home-core-action--{{item.id}}" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="openQuickAction">
        <view class="home-core-action__mark"></view><view class="home-core-action__title">{{item.title}}</view><view class="home-core-action__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title"><text class="section-title__text">校园圈动态</text><text class="section-title__action" data-url="/pages/community/community" data-tab="{{true}}" bindtap="openQuickAction">去看看</text></view>
    <view class="community-spotlight card" wx:if="{{communitySpotlight}}" data-url="{{communitySpotlight.url}}" data-tab="{{true}}" bindtap="openQuickAction">
      <view class="community-spotlight__top"><text class="community-spotlight__badge">{{communitySpotlight.typeLabel}}</text><text class="community-spotlight__meta">{{communitySpotlight.meta}}</text></view>
      <view class="community-spotlight__title">{{communitySpotlight.title}}</view>
      <view class="community-spotlight__desc">{{communitySpotlight.excerpt}}</view>
      <view class="community-spotlight__stats"><text>全部 {{communitySpotlight.totalCount}}</text><text>热门 {{communitySpotlight.hotCount}}</text></view>
    </view>
  </view>

  <view class="section">
    <view class="workbench-grid">
      <view class="workbench-card card workbench-card--primary" wx:if="{{todayAction}}"><view class="workbench-card__label">今日行动</view><view class="workbench-card__title">{{todayAction.title}}</view><view class="workbench-card__desc">{{todayAction.subtitle}}</view><view class="workbench-card__footer">{{todayAction.progressText}}</view></view>
      <view class="workbench-card card" wx:if="{{notices.length}}" data-id="{{notices[0].id}}" bindtap="openNotice"><view class="workbench-card__label">最近通知</view><view class="workbench-card__title">{{notices[0].title}}</view><view class="workbench-card__desc">{{notices[0].summary}}</view><view class="workbench-card__footer">查看详情</view></view>
    </view>
  </view>

  <ai-fab />
</view>
