<view class="page enterprise-page">
  <view class="skeleton-panel card" wx:if="{{loading}}">
    <view class="skeleton-line skeleton-line--hero"></view>
    <view class="skeleton-grid">
      <view class="skeleton-box"></view>
      <view class="skeleton-box"></view>
      <view class="skeleton-box"></view>
    </view>
    <view class="skeleton-line"></view>
  </view>

  <view class="enterprise-hero">
    <view class="enterprise-hero__top">
      <view>
        <view class="enterprise-hero__eyebrow">智慧校园服务门户</view>
        <view class="enterprise-hero__title">校园服务工作台</view>
        <view class="enterprise-hero__desc">统一聚合地图导览、办事服务、公告通知和学习资源，支撑学生日常事务与校园运营管理。</view>
      </view>
      <view class="enterprise-hero__role">
        <text class="enterprise-hero__role-label">当前身份</text>
        <text class="enterprise-hero__role-value">学生</text>
      </view>
    </view>
    <view class="enterprise-hero__campus">广州应用科技学院肇庆校区</view>
    <view class="enterprise-metrics">
      <view class="enterprise-metric">
        <text class="enterprise-metric__num">{{notices.length}}</text>
        <text class="enterprise-metric__label">未读通知</text>
      </view>
      <view class="enterprise-metric">
        <text class="enterprise-metric__num">{{explorationSummary ? explorationSummary.routeProgressText : '0/3'}}</text>
        <text class="enterprise-metric__label">路线进度</text>
      </view>
      <view class="enterprise-metric">
        <text class="enterprise-metric__num">{{studySummary ? studySummary.viewedCount : 0}}</text>
        <text class="enterprise-metric__label">学习访问</text>
      </view>
      <view class="enterprise-metric">
        <text class="enterprise-metric__num">0</text>
        <text class="enterprise-metric__label">我的工单</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="workbench-grid">
      <view class="workbench-card card workbench-card--primary" wx:if="{{todayAction}}">
        <view class="workbench-card__label">今日待办</view>
        <view class="workbench-card__title">{{todayAction.title}}</view>
        <view class="workbench-card__desc">{{todayAction.subtitle}}</view>
        <view class="workbench-card__footer">{{todayAction.progressText}}</view>
      </view>
      <view class="workbench-card card" wx:if="{{notices.length}}" data-id="{{notices[0].id}}" bindtap="openNotice">
        <view class="workbench-card__label">紧急通知</view>
        <view class="workbench-card__title">{{notices[0].title}}</view>
        <view class="workbench-card__desc">{{notices[0].summary}}</view>
        <view class="workbench-card__footer">查看详情</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="section-title__text">常用服务</text>
      <text class="section-title__action" data-url="/pages/service/service" bindtap="openQuickAction">全部服务</text>
    </view>
    <view class="service-grid">
      <view
        wx:for="{{quickActions}}"
        wx:key="id"
        class="service-entry card"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="openQuickAction"
      >
        <view class="service-entry__code">{{index + 1}}</view>
        <view class="service-entry__title">{{item.title}}</view>
        <view class="service-entry__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="section-title__text">最近访问</text>
      <text class="section-title__action" data-url="/pages/studyHistory/studyHistory" bindtap="openQuickAction">查看记录</text>
    </view>
    <view class="recent-panel card">
      <view class="recent-panel__main" wx:if="{{continueStudy}}" bindtap="openContinueStudy">
        <view class="recent-panel__label">学习资源</view>
        <view class="recent-panel__title">{{continueStudy.title}}</view>
        <view class="recent-panel__desc">{{continueStudy.summary}}</view>
      </view>
      <view class="recent-panel__main" wx:else>
        <view class="recent-panel__label">暂无访问记录</view>
        <view class="recent-panel__title">进入服务或学习资源后会在这里沉淀记录</view>
        <view class="recent-panel__desc">用于快速回到最近办理、查看或学习的内容。</view>
      </view>
    </view>
  </view>

</view>
