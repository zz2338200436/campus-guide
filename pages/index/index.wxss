.home-page {
  background: #f7f9fb;
}

.home-hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #e5edf0;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.04);
}

.home-hero__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.home-hero__eyebrow {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.home-hero__title {
  margin-top: 10rpx;
  color: #1f2937;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.22;
}

.home-hero__desc {
  margin-top: 14rpx;
  color: #5b6675;
  font-size: 25rpx;
  line-height: 1.62;
}

.home-hero__role {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  min-width: 132rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f7f9fb;
  border: 1rpx solid #e5edf0;
}

.home-hero__role-label {
  color: #7b8794;
  font-size: 20rpx;
  line-height: 1.3;
}

.home-hero__role-value {
  margin-top: 6rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.home-hero__campus {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5edf0;
  color: #5b6675;
  font-size: 24rpx;
  line-height: 1.4;
}

.home-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.home-metric {
  min-height: 100rpx;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  background: #f7f9fb;
  border: 1rpx solid #e5edf0;
}

.home-metric__num {
  display: block;
  color: #0f766e;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.home-metric__label {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.35;
}

.workbench-grid,
.capability-grid {
  display: grid;
  gap: 16rpx;
}

.workbench-card {
  padding: 26rpx;
}

.workbench-card--primary {
  border-left: 8rpx solid #0f766e;
}

.workbench-card__label,
.recent-panel__label,
.capability-card__label {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.workbench-card__title,
.recent-panel__title,
.home-list__title,
.capability-card__title {
  margin-top: 10rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.42;
}

.workbench-card__desc,
.recent-panel__desc,
.home-list__desc,
.capability-card__desc {
  margin-top: 8rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.58;
}

.workbench-card__footer {
  margin-top: 16rpx;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.service-entry {
  min-height: 166rpx;
  padding: 22rpx;
}

.service-entry__code {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 900;
}

.service-entry__title {
  margin-top: 16rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.35;
}

.service-entry__desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.recent-panel {
  padding: 26rpx;
}

.home-list {
  display: grid;
  gap: 12rpx;
}

.home-list__item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.home-list__body {
  flex: 1;
  min-width: 0;
}

.home-list__meta {
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.45;
}

.home-list__action {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
}

.capability-card {
  padding: 24rpx;
}
