.page {
  padding-bottom: 184rpx;
}

.home-page {
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
  background: #faf9f7;
}

/* ── Hero (unchanged structure, light color tune) ── */
.home-hero {
  margin: -6rpx -4rpx 20rpx;
}

.home-hero-swiper {
  height: 372rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ccfbf1;
}

.home-hero-slide {
  position: relative;
  width: 100%;
  height: 372rpx;
  overflow: hidden;
}

.home-hero-slide__image {
  width: 100%;
  height: 100%;
}

.home-hero-slide__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.72));
}

.home-hero-slide__caption {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
}

.home-hero__eyebrow,
.home-hero__title,
.home-hero__desc {
  display: block;
  color: #ffffff;
}

/* ── Typography hierarchy (5-level) ── */
.home-hero__eyebrow {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  opacity: 0.9;
}

.home-hero__title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
}

.home-hero__desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.4;
  opacity: 0.94;
}

/* ── Next Place Card ── */
.home-next {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 24rpx 22rpx;
  border-color: #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.home-next:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.home-next__top,
.home-core-action__top {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
}

.home-next__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #e8f1ff;
}

.home-next__symbol {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.home-next__body {
  min-width: 0;
}

/* ── Module label (34rpx/700) ── */
.home-next__label,
.workbench-card__label,
.community-spotlight__badge {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

/* ── Card title (30rpx/600) ── */
.home-next__title,
.workbench-card__title,
.community-spotlight__title {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Body text (26rpx/400), improved contrast ── */
.home-next__desc,
.workbench-card__desc,
.community-spotlight__desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ── Core action grid ── */
.home-core-grid,
.workbench-grid {
  display: grid;
  gap: 16rpx;
}

.home-core-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.home-core-action {
  display: flex;
  flex-direction: column;
  min-height: 156rpx;
  padding: 22rpx;
  border-color: #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.home-core-action:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.home-core-action__top {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
}

.home-core-action__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #eef4ff;
}

.home-core-action__symbol {
  color: #315b9a;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.home-core-action--map .home-core-action__mark {
  background: #e8f1ff;
}

.home-core-action__title {
  margin-top: 12rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.home-core-action--map .home-core-action__symbol {
  color: #0f766e;
}

.home-core-action--community .home-core-action__mark {
  background: #e6fbf6;
}

.home-core-action--community .home-core-action__symbol {
  color: #0f766e;
}

.home-core-action--service .home-core-action__mark {
  background: #fff7da;
}

.home-core-action--service .home-core-action__symbol {
  color: #ca8a04;
}

.home-core-action--survival .home-core-action__mark {
  background: #eef0ff;
}

.home-core-action--survival .home-core-action__symbol {
  color: #6366f1;
}

.home-core-action__desc {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Community spotlight & workbench cards ── */
.community-spotlight,
.workbench-card {
  padding: 28rpx;
}

.community-spotlight:active,
.workbench-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.community-spotlight__top,
.community-spotlight__stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.community-spotlight__meta,
.community-spotlight__stats {
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.community-spotlight__stats {
  justify-content: flex-start;
  margin-top: 18rpx;
  gap: 24rpx;
  font-weight: 600;
}

/* ── Today Action Card (elevation-3 emphasis) ── */
.workbench-card--primary {
  border-left: 8rpx solid #0f766e;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.08);
}

/* ── Today Action: progress bar ── */
.workbench-card__progress-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 14rpx 0 18rpx;
}

.workbench-card__progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #e8edf2;
  overflow: hidden;
}

.workbench-card__progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0f766e, #14b8a6);
  transition: width 380ms ease;
}

.workbench-card__progress-num {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

/* ── Today Action: task items ── */
.workbench-card__tasks {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.workbench-card__task {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #faf9f7;
  transition: background 180ms ease;
}

.workbench-card__task:active {
  background: #ecfdf5;
}

.workbench-card__task-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #d7dde4;
  background: #ffffff;
  transition: all 180ms ease;
}

.workbench-card__task-check--done {
  border-color: #0f766e;
  background: #0f766e;
}

.workbench-card__task-check--done .workbench-card__task-icon {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.workbench-card__task-text {
  flex: 1;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
  transition: color 180ms ease;
}

.workbench-card__task-text--done {
  color: #9ca3af;
  text-decoration: line-through;
}

.workbench-card__footer {
  margin-top: 16rpx;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

/* ── Section spacing ── */
.home-page .section {
  margin-bottom: 28rpx;
}

.home-page .section-title {
  margin-bottom: 18rpx;
}

.home-page .section-title__action {
  color: #4b5563;
}

/* ── Dark theme ── */
.theme-dark.home-page {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
  background: #0b1220;
}

.theme-dark .home-hero {
  background: linear-gradient(180deg, #111c31 0%, #0f172a 100%);
}

.theme-dark .home-hero-swiper {
  border: 1rpx solid rgba(94, 234, 212, 0.16);
  background: #111827;
}

.theme-dark .home-hero-slide__shade {
  background: linear-gradient(180deg, rgba(2, 6, 23, 0.08), rgba(2, 6, 23, 0.78));
}

.theme-dark .home-next,
.theme-dark .home-metric,
.theme-dark .home-core-action,
.theme-dark .community-spotlight,
.theme-dark .workbench-card {
  border-color: rgba(148, 163, 184, 0.16);
  background: #111827;
  box-shadow: 0 14rpx 34rpx rgba(2, 6, 23, 0.22);
}

.theme-dark .home-next:active,
.theme-dark .home-metric:active,
.theme-dark .home-core-action:active,
.theme-dark .community-spotlight:active,
.theme-dark .workbench-card:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 18rpx rgba(2, 6, 23, 0.16);
}

.theme-dark .home-hero,
.theme-dark .home-hero-swiper {
  border-color: rgba(94, 234, 212, 0.16);
}

.theme-dark .home-next__title,
.theme-dark .home-core-action__title,
.theme-dark .community-spotlight__title,
.theme-dark .workbench-card__title {
  color: #e5e7eb;
}

.theme-dark .home-next__desc,
.theme-dark .home-core-action__desc,
.theme-dark .community-spotlight__desc,
.theme-dark .community-spotlight__meta,
.theme-dark .community-spotlight__stats,
.theme-dark .workbench-card__desc {
  color: #cbd5e1;
}

.theme-dark .home-next__label,
.theme-dark .home-next__meta,
.theme-dark .community-spotlight__badge,
.theme-dark .workbench-card__label,
.theme-dark .workbench-card__footer {
  color: #5eead4;
}

.theme-dark .home-next__hint {
  color: #cbd5e1;
}

.theme-dark .home-next__action {
  color: #5eead4;
}

/* Dark: today action tasks */
.theme-dark .workbench-card__task {
  background: #172033;
}

.theme-dark .workbench-card__task:active {
  background: rgba(15, 118, 110, 0.12);
}

.theme-dark .workbench-card__task-check {
  border-color: #334155;
  background: #111827;
}

.theme-dark .workbench-card__task-check--done {
  border-color: #0f766e;
  background: #0f766e;
}

.theme-dark .workbench-card__task-text {
  color: #e5e7eb;
}

.theme-dark .workbench-card__task-text--done {
  color: #64748b;
}

.theme-dark .workbench-card__progress-track {
  background: #263445;
}

.theme-dark .workbench-card__progress-num {
  color: #5eead4;
}
