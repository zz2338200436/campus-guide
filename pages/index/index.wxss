.home-page {
  padding-bottom: 188rpx;
  background: #f3f8fb;
}

.home-hero {
  margin: -6rpx -4rpx 18rpx;
}

.home-hero-swiper {
  height: 430rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #dbeafe;
}

.home-hero-slide {
  position: relative;
  width: 100%;
  height: 430rpx;
  overflow: hidden;
}

.home-hero-slide__image {
  width: 100%;
  height: 100%;
}

.home-hero-slide__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.72));
}

.home-hero-slide__caption {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 30rpx;
}

.home-hero__eyebrow,
.home-hero__title,
.home-hero__desc {
  display: block;
  color: #ffffff;
}

.home-hero__eyebrow {
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  opacity: 0.9;
}

.home-hero__title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.22;
}

.home-hero__desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.45;
  opacity: 0.94;
}

.home-next {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.home-next__body {
  flex: 1;
  min-width: 0;
}

.home-next__label,
.workbench-card__label,
.community-spotlight__badge {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.home-next__title,
.workbench-card__title,
.community-spotlight__title {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.36;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-next__desc,
.workbench-card__desc,
.community-spotlight__desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.home-next__action {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 58rpx;
  border-radius: 8rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.home-core-grid,
.workbench-grid {
  display: grid;
  gap: 14rpx;
}

.home-core-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.home-core-action {
  min-height: 168rpx;
  padding: 22rpx;
}

.home-core-action__mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #dcfce7;
}

.home-core-action--map .home-core-action__mark {
  background: #dbeafe;
}

.home-core-action--community .home-core-action__mark {
  background: #ccfbf1;
}

.home-core-action--service .home-core-action__mark {
  background: #fef3c7;
}

.home-core-action--survival .home-core-action__mark {
  background: #e0e7ff;
}

.home-core-action__title {
  margin-top: 16rpx;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.home-core-action__desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.community-spotlight,
.workbench-card {
  padding: 24rpx;
}

.community-spotlight__top,
.community-spotlight__stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.community-spotlight__meta,
.community-spotlight__stats {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
}

.community-spotlight__stats {
  justify-content: flex-start;
  margin-top: 16rpx;
  font-weight: 800;
}

.workbench-card--primary {
  border-left: 8rpx solid #0f766e;
}

.workbench-card__footer {
  margin-top: 16rpx;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.theme-dark.home-page {
  padding-bottom: 210rpx;
  background: #0b1220;
}

.theme-dark .home-hero {
  background: linear-gradient(180deg, #111c31 0%, #0f172a 100%);
}

.theme-dark .home-hero-swiper {
  border: 1rpx solid rgba(94, 234, 212, 0.16);
  background: #111827;
}

.theme-dark .home-hero-slide__shade {
  background: linear-gradient(180deg, rgba(2, 6, 23, 0.08), rgba(2, 6, 23, 0.78));
}

.theme-dark .home-next,
.theme-dark .home-metric,
.theme-dark .home-core-action,
.theme-dark .community-spotlight,
.theme-dark .workbench-card {
  border-color: rgba(148, 163, 184, 0.16);
  background: #111827;
  box-shadow: 0 14rpx 34rpx rgba(2, 6, 23, 0.22);
}

.theme-dark .home-hero,
.theme-dark .home-hero-swiper {
  border-color: rgba(94, 234, 212, 0.16);
}

.theme-dark .home-next__title,
.theme-dark .home-core-action__title,
.theme-dark .community-spotlight__title,
.theme-dark .workbench-card__title {
  color: #e5e7eb;
}

.theme-dark .home-next__desc,
.theme-dark .home-core-action__desc,
.theme-dark .community-spotlight__desc,
.theme-dark .community-spotlight__meta,
.theme-dark .community-spotlight__stats,
.theme-dark .workbench-card__desc {
  color: #94a3b8;
}

.theme-dark .home-next__label,
.theme-dark .community-spotlight__badge,
.theme-dark .workbench-card__label,
.theme-dark .workbench-card__footer {
  color: #5eead4;
}

.theme-dark .home-next__action {
  background: #14b8a6;
  color: #06201d;
}
