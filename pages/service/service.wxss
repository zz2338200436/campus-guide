/* ═══════════ 8. Skeleton Loading ═══════════ */
.skeleton-shell {
  display: grid;
  gap: 28rpx;
}

.skeleton-hero {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: #e8edf2;
}

.skeleton-card {
  padding: 26rpx;
  border-radius: 20rpx;
  background: #e8edf2;
}

.skeleton-line {
  height: 22rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #dce3ea 24%, #eaf0f5 52%, #dce3ea 76%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.6s infinite ease-in-out;
  margin-bottom: 14rpx;
}

.skeleton-line:last-child {
  margin-bottom: 0;
}

.skeleton-line--w40 { width: 40%; }
.skeleton-line--w50 { width: 50%; }
.skeleton-line--w60 { width: 60%; }
.skeleton-line--w70 { width: 70%; }
.skeleton-line--w80 { width: 80%; }
.skeleton-line--w90 { width: 90%; }
.skeleton-line--w100 { width: 100%; }

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.theme-dark .skeleton-hero,
.theme-dark .skeleton-card {
  background: #172033;
}

.theme-dark .skeleton-line {
  background: linear-gradient(90deg, #1e2d3d 24%, #263445 52%, #1e2d3d 76%);
  background-size: 200% 100%;
}

@media (prefers-reduced-motion: reduce) {
  .theme-dark .skeleton-line {
    animation: none;
    background: #1e2d3d;
  }
}

/* ═══════════ 9. Reduced Motion & A11y ═══════════ */
@media (prefers-reduced-motion: reduce) {
  .service-promise__item:active,
  .issue-tab:active,
  .ticket-bar__action--primary:active,
  .issue-service__phone:active,
  .service-row__call:active,
  .service-alert-row__phone:active,
  .type-pill:active {
    transform: none;
    transition: none;
  }
  .skeleton-line {
    animation: none;
    background: #dce3ea;
  }
}
