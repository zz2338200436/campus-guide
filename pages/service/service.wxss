/* ═══════════════════════════════════════════════════════
   Service Hall — Calm Student Teal System
   校园服务问题解决中心
   Matches project design: #0f766e / #faf9f7 / elevation-2
   ═══════════════════════════════════════════════════════ */

.page.service-hall-page {
  padding-bottom: 184rpx;
  background: #faf9f7;
  touch-action: manipulation;
  overscroll-behavior: contain;
}

/* ═══════════ 1. Hero Banner ═══════════ */
.service-hero {
  position: relative;
  margin-bottom: 28rpx;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 60%, #2dd4bf 100%);
  box-shadow: 0 8rpx 26rpx rgba(15, 118, 110, 0.14);
  overflow: hidden;
}

.service-hero::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.service-hero::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.service-hero__title {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: -0.02em;
}

.service-hero__chips {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.service-hero__chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.service-hero__chip-icon {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  position: relative;
}

.service-hero__chip-icon--nav::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 14rpx solid #fff;
}

.service-hero__chip-icon--nav::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}

.service-hero__chip-icon--repair::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  border: 3rpx solid #fff;
  box-sizing: border-box;
}

.service-hero__chip-icon--repair::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 8rpx;
  height: 3rpx;
  background: #fff;
}

.service-hero__chip-icon--phone::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  width: 10rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-radius: 6rpx 6rpx 3rpx 3rpx;
  box-sizing: border-box;
}

.service-hero__chip-icon--phone::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 7rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #fff;
}

.service-hero__stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 36rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.20);
}

.service-hero__stat {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.service-hero__stat-num {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.service-hero__stat-label {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

/* ═══════════ 2. Ticket Action Bar ═══════════ */
.ticket-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.ticket-bar__main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.ticket-bar__icon-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0f766e;
  box-shadow: 0 0 0 6rpx rgba(15, 118, 110, 0.12);
}

.ticket-bar__info {
  min-width: 0;
}

.ticket-bar__label {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ticket-bar__status {
  margin-top: 4rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ticket-bar__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 16rpx;
}

.ticket-bar__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
  transition: all 180ms ease;
}

.ticket-bar__action--primary {
  background: #0f766e;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.20);
}

.ticket-bar__action--primary:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 6rpx rgba(15, 118, 110, 0.12);
}

.ticket-bar__action--outline {
  background: #ffffff;
  border: 1.5rpx solid #e8edf2;
  color: #0f766e;
}

.ticket-bar__action--outline:active {
  background: #ecfdf5;
  border-color: #14b8a6;
}

.ticket-bar__action--ghost {
  background: transparent;
  color: #6b7280;
}

.ticket-bar__action--ghost:active {
  color: #0f766e;
  background: #ecfdf5;
}

/* ═══════════ 3. Service Promise — 3-column cards ═══════════ */
.service-promise {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.service-promise__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-height: 112rpx;
  padding: 20rpx 10rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.service-promise__item:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.service-promise__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #ecfdf5;
}

.service-promise__icon-pin {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.service-promise__icon-pin::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 16rpx solid #0f766e;
}

.service-promise__icon-pin::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0f766e;
}

.service-promise__icon-clipboard {
  position: relative;
  width: 26rpx;
  height: 30rpx;
  border: 3rpx solid #0f766e;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.service-promise__icon-clipboard::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #0f766e;
}

.service-promise__icon-clipboard::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 4rpx;
  width: 8rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #0f766e;
}

.service-promise__icon-phone {
  position: relative;
  width: 22rpx;
  height: 28rpx;
}

.service-promise__icon-phone::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 3rpx;
  width: 14rpx;
  height: 20rpx;
  border: 3rpx solid #0f766e;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  box-sizing: border-box;
}

.service-promise__icon-phone::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 7rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #0f766e;
}

.service-promise__label {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.service-promise__value {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

/* ═══════════ 4. Issue Solver ═══════════ */
.issue-solver {
  margin-bottom: 28rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.issue-solver__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.issue-solver__label {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.05em;
  line-height: 1.4;
}

.issue-solver__count {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

/* ── Issue tab scroll ── */
.issue-tabs {
  display: flex;
  align-items: flex-start;
  height: 148rpx;
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.issue-tab {
  display: inline-flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 210rpx;
  height: 132rpx;
  box-sizing: border-box;
  margin-right: 14rpx;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: #faf9f7;
  border: 2rpx solid transparent;
  white-space: normal;
  overflow: hidden;
  transition: all 220ms ease;
}

.issue-tab:active {
  transform: scale(0.97);
}

.issue-tab--active {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  border-color: #0f766e;
  box-shadow: 0 6rpx 20rpx rgba(15, 118, 110, 0.20);
}

.issue-tab__question {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color 220ms ease;
}

.issue-tab__title {
  margin-top: 6rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.32;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  transition: color 220ms ease;
}

.issue-tab--active .issue-tab__question,
.issue-tab--active .issue-tab__title {
  color: #ffffff;
}

/* ── Issue detail panel ── */
.issue-panel {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #faf9f7;
  border: 1rpx solid #e8edf2;
}

.issue-panel__intro {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e8edf2;
}

.issue-panel__title {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.42;
}

.issue-panel__desc {
  margin-top: 6rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.58;
}

.issue-panel__list {
  display: grid;
  gap: 12rpx;
}

.issue-service {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf2;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.04);
  transition: box-shadow 180ms ease;
}

.issue-service:active {
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.issue-service__main {
  flex: 1;
  min-width: 0;
}

.issue-service__tag {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.issue-service__title {
  margin-top: 4rpx;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.42;
}

.issue-service__desc {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.issue-service__meta {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 1.5;
}

.issue-service__actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 130rpx;
  gap: 10rpx;
  text-align: right;
}

.issue-service__action {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.issue-service__phone {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  min-width: 108rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  box-shadow: 0 3rpx 10rpx rgba(15, 118, 110, 0.18);
  transition: transform 180ms ease;
}

.issue-service__phone:active {
  transform: scale(0.95);
}

/* ═══════════ 5. Service Alert ═══════════ */
.service-alert {
  margin-bottom: 28rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.service-alert__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.service-alert__label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #E11D48;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.05em;
  line-height: 1.4;
}

.service-alert__label-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E11D48;
}

.service-alert__count {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #FFF1F2;
  color: #E11D48;
  font-size: 24rpx;
  font-weight: 800;
}

.service-alert__list {
  display: grid;
  gap: 12rpx;
}

.service-alert-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #FFF1F2;
  border: 1rpx solid #FFE4E6;
  transition: background 180ms ease;
}

.service-alert-row:active {
  background: #FFE4E6;
}

.service-alert-row__main {
  flex: 1;
  min-width: 0;
}

.service-alert-row__name {
  color: #881337;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-alert-row__meta {
  margin-top: 6rpx;
  color: #9F1239;
  font-size: 22rpx;
  line-height: 1.5;
}

.service-alert-row__actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 130rpx;
  gap: 10rpx;
  text-align: right;
}

.service-alert-row__action {
  color: #E11D48;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.service-alert-row__phone {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  min-width: 108rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #E11D48;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  box-shadow: 0 3rpx 10rpx rgba(225, 29, 72, 0.18);
  transition: transform 180ms ease;
}

.service-alert-row__phone:active {
  transform: scale(0.95);
}

/* ═══════════ 6. Category Filter Pills ═══════════ */
.type-scroll {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: 24rpx;
  padding: 8rpx 0;
  background: #faf9f7;
}

.filter-scroll {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
  overflow-x: scroll;
}

.type-pill {
  display: inline-block;
  height: 56rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  line-height: 56rpx;
  background: #ffffff;
  border: 1rpx solid #dde3e9;
  color: #4b5563;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  box-sizing: border-box;
  transition: all 220ms ease;
}

.type-pill:active {
  transform: scale(0.96);
}

.type-pill--active {
  background: #0f766e;
  border-color: #0f766e;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(15, 118, 110, 0.12);
}

/* ═══════════ 7. Service Groups ═══════════ */
.panel-grid {
  display: grid;
  gap: 28rpx;
}

.service-group {
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf2;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.service-group__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 6rpx;
}

.service-group__label {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.05em;
  line-height: 1.4;
}

.service-group__title {
  margin-top: 4rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.service-group__count {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

/* ── Service rows ── */
.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #e8edf2;
  transition: background 180ms ease;
}

.service-row:first-of-type {
  border-top: 0;
  padding-top: 6rpx;
}

.service-row:active {
  background: #faf9f7;
  margin: 0 -26rpx;
  padding-left: 26rpx;
  padding-right: 26rpx;
  border-radius: 12rpx;
}

.service-row__main {
  flex: 1;
  min-width: 0;
}

.service-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.service-row__title {
  flex: 1;
  min-width: 0;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.service-row__tag {
  flex-shrink: 0;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.service-row__meta {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.service-row__materials {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-row__actions {
  display: none;
}

.service-row__summary {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.service-row__loc-pin {
  display: block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #0f766e;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.service-row__loc {
  flex: 1;
  min-width: 0;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-row__expand-hint {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.service-row__detail {
  margin-top: 12rpx;
}

.service-row__actions-inline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.service-row--expanded {
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #e8edf2;
}

.service-row--expanded + .service-row {
  border-top: 0;
  padding-top: 18rpx;
}

.service-row__action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  border-radius: 14rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
  transition: background 180ms ease;
}

.service-row__action:active {
  background: #ccfbf1;
}

.service-row__call {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  min-width: 108rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  box-shadow: 0 3rpx 10rpx rgba(15, 118, 110, 0.18);
  transition: transform 180ms ease;
}

.service-row__call:active {
  transform: scale(0.95);
}

