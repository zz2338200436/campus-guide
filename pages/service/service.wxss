.service-hall-page {
  background: #f7f9fb;
}

.service-summary {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 26rpx;
}

.service-summary__main {
  flex: 1;
  min-width: 0;
}

.service-summary__eyebrow {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.service-summary__title {
  margin-top: 10rpx;
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.3;
}

.service-summary__desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.48;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-summary__metrics {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  gap: 18rpx;
}

.service-summary__metric {
  min-width: 82rpx;
  padding-left: 18rpx;
  border-left: 1rpx solid #e2e8f0;
}

.service-summary__metric:first-child {
  border-left: 0;
  padding-left: 0;
}

.service-summary__metric-num {
  display: block;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 850;
  text-align: right;
}

.service-summary__metric-label {
  display: block;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: right;
}

.ticket-bar,
.issue-solver,
.service-alert,
.service-group {
  margin-bottom: 24rpx;
  padding: 26rpx;
}

.issue-solver__head,
.service-alert__head,
.service-group__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.issue-solver__label,
.service-alert__label,
.service-group__label,
.issue-service__tag {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.issue-solver__title,
.service-alert__title,
.service-group__title,
.service-row__title,
.issue-service__title,
.service-alert-row__name {
  margin-top: 10rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.42;
}

.issue-solver__count,
.service-alert__count,
.service-group__count {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 800;
}

.ticket-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
}

.ticket-bar__main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.ticket-bar__label {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.35;
  white-space: nowrap;
}

.ticket-bar__status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 800;
}

.ticket-bar__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10rpx;
}

.ticket-bar__action {
  padding: 9rpx 13rpx;
  border-radius: 12rpx;
  background: #f7f9fb;
  border: 1rpx solid #e2e8f0;
  color: #334155;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
  white-space: nowrap;
}

.ticket-bar__action--primary {
  background: #0f766e;
  border-color: #0f766e;
  color: #ffffff;
}

.issue-tabs {
  display: flex;
  align-items: flex-start;
  height: 148rpx;
  margin-top: 20rpx;
  white-space: nowrap;
}

.service-quick-strip {
  display: flex;
  margin-top: 20rpx;
  white-space: nowrap;
}

.issue-tab {
  display: inline-flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 220rpx;
  height: 126rpx;
  box-sizing: border-box;
  margin-right: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  white-space: normal;
  overflow: hidden;
}

.issue-tab--active {
  background: #0f766e;
  border-color: #0f766e;
}

.issue-tab__question {
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.issue-tab__title {
  margin-top: 6rpx;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.32;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.issue-tab--active .issue-tab__question,
.issue-tab--active .issue-tab__title {
  color: #ffffff;
}

.issue-panel {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f9fb;
  border: 1rpx solid #e2e8f0;
}

.issue-panel__title {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.42;
}

.issue-panel__desc,
.issue-service__desc {
  margin-top: 8rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.58;
}

.issue-panel__list,
.service-alert__list {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.issue-service,
.service-alert-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.issue-service__main {
  flex: 1;
  min-width: 0;
}

.service-alert-row__main {
  flex: 1;
  min-width: 0;
}

.service-alert-row__name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.issue-service__meta,
.service-row__meta,
.service-row__materials,
.service-alert-row__meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.45;
}

.issue-service__actions,
.service-alert-row__actions,
.service-row__actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 128rpx;
  gap: 10rpx;
  text-align: right;
}

.issue-service__action,
.service-row__action,
.service-alert-row__action {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
}

.issue-service__phone,
.service-alert-row__phone,
.service-row__call {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.service-alert-row__name {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.45;
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.service-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.service-row__main {
  flex: 1;
  min-width: 0;
}

.service-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.service-row__title {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-row__tag {
  flex-shrink: 0;
}

.service-row__materials {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-row__call,
.service-alert-row__phone {
  min-width: 84rpx;
}
