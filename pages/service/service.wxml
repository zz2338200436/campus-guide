<view class="page service-hall-page {{themeClass}}">
  <view class="service-summary card">
    <view class="service-summary__main">
      <view class="service-summary__eyebrow">Campus Service Desk</view>
      <view class="service-summary__title">校园服务问题解决中心</view>
      <view class="service-summary__desc">把报到、报修、证明、失物和应急联系整理成可执行的办理指引。</view>
    </view>
    <view class="service-summary__metrics">
      <view class="service-summary__metric">
        <text class="service-summary__metric-num">{{list.length}}</text>
        <text class="service-summary__metric-label">服务</text>
      </view>
      <view class="service-summary__metric">
        <text class="service-summary__metric-num">{{quickList.length}}</text>
        <text class="service-summary__metric-label">常用</text>
      </view>
      <view class="service-summary__metric">
        <text class="service-summary__metric-num">{{urgentList.length}}</text>
        <text class="service-summary__metric-label">紧急</text>
      </view>
    </view>
  </view>

  <view class="ticket-bar card">
    <view class="ticket-bar__main">
      <view class="ticket-bar__label">咨询与报修</view>
      <view class="ticket-bar__status">演示通道</view>
    </view>
    <view class="ticket-bar__actions">
      <view class="ticket-bar__action ticket-bar__action--primary" bindtap="openConsultEntry">我要咨询</view>
      <view class="ticket-bar__action" data-scene="repair" bindtap="openSurvivalRoute">我要报修</view>
      <view class="ticket-bar__action" bindtap="openTicketProgress">办理进度</view>
    </view>
  </view>

  <view class="service-promise card">
    <view class="service-promise__item"><text class="service-promise__label">去哪办</text><text class="service-promise__value">关联地点</text></view>
    <view class="service-promise__item"><text class="service-promise__label">带什么</text><text class="service-promise__value">材料清单</text></view>
    <view class="service-promise__item"><text class="service-promise__label">联系谁</text><text class="service-promise__value">电话直达</text></view>
  </view>

  <view class="issue-solver card" wx:if="{{issueTabs.length}}">
    <view class="issue-solver__head">
      <view>
        <view class="issue-solver__label">服务导航</view>
        <view class="issue-solver__title">按问题找到办理入口</view>
      </view>
      <view class="issue-solver__count">{{issueTabs.length}} 类问题</view>
    </view>
    <scroll-view class="issue-tabs" scroll-x enable-flex>
      <view wx:for="{{issueTabs}}" wx:key="id" class="issue-tab {{currentIssueId === item.id ? 'issue-tab--active' : ''}}" data-id="{{item.id}}" bindtap="selectIssue">
        <view class="issue-tab__question">{{item.question}}</view>
        <view class="issue-tab__title">{{item.title}}</view>
      </view>
    </scroll-view>
    <view class="issue-panel" wx:if="{{currentIssue}}">
      <view class="issue-panel__intro">
        <view class="issue-panel__title">{{currentIssue.title}}</view>
        <view class="issue-panel__desc">{{currentIssue.desc}}</view>
      </view>
      <view class="issue-panel__list">
        <view wx:for="{{issueServices}}" wx:key="id" class="issue-service" data-place-id="{{item.primaryPlaceId}}" bindtap="openServicePlace">
          <view class="issue-service__main">
            <view class="issue-service__tag">{{item.category}} · {{item.tag}}</view>
            <view class="issue-service__title">{{item.title}}</view>
            <view class="issue-service__desc">{{item.content}}</view>
            <view class="issue-service__meta">地点：{{item.location}} · 开放时间：{{item.time}}</view>
          </view>
          <view class="issue-service__actions">
            <view class="issue-service__action">{{item.primaryPlaceName ? '查看地点' : item.actionText}}</view>
            <view class="issue-service__phone" data-phone="{{item.phone}}" catchtap="callServicePhone">拨打</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="service-alert card" wx:if="{{urgentList.length}}">
    <view class="service-alert__head">
      <view>
        <view class="service-alert__label">安全应急</view>
        <view class="service-alert__title">失物、断网、设备异常和紧急联系</view>
      </view>
      <view class="service-alert__count">{{urgentList.length}} 项</view>
    </view>
    <view class="service-alert__list">
      <view class="service-alert-row" wx:for="{{urgentList}}" wx:key="id" data-place-id="{{item.primaryPlaceId}}" bindtap="openServicePlace">
        <view class="service-alert-row__main">
          <view class="service-alert-row__name">{{item.title}}</view>
          <view class="service-alert-row__meta">开放时间：{{item.time}}</view>
        </view>
        <view class="service-alert-row__actions">
          <view class="service-alert-row__action">{{item.actionText}}</view>
          <view class="service-alert-row__phone" data-phone="{{item.phone}}" catchtap="callServicePhone">拨打</view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="type-scroll filter-scroll" scroll-x enable-flex>
    <view wx:for="{{categoryTabs}}" wx:key="*this" class="type-pill {{currentCategory === item ? 'type-pill--active' : ''}}" data-category="{{item}}" bindtap="selectCategory">
      {{item}}
    </view>
  </scroll-view>

  <view class="panel-grid">
    <view class="service-group card" wx:for="{{serviceGroups}}" wx:key="title">
      <view class="service-group__head">
        <view>
          <view class="service-group__label">办理事项</view>
          <view class="service-group__title">{{item.title}}</view>
        </view>
        <view class="service-group__count">{{item.items.length}} 项</view>
      </view>
      <view class="service-row" wx:for="{{item.items}}" wx:key="id" data-place-id="{{item.primaryPlaceId}}" bindtap="openServicePlace">
        <view class="service-row__main">
          <view class="service-row__head">
            <view class="service-row__title">{{item.title}}</view>
            <text class="tag service-row__tag">{{item.tag}}</text>
          </view>
          <view class="service-row__meta">地点：{{item.location}} · 开放时间：{{item.time}}</view>
          <view class="service-row__materials">所需材料：{{item.materials.join('、')}}</view>
        </view>
        <view class="service-row__actions">
          <text class="service-row__action">{{item.primaryPlaceName ? '查看地点' : item.actionText}}</text>
          <text class="service-row__call" data-phone="{{item.phone}}" catchtap="callServicePhone">拨打</text>
        </view>
      </view>
    </view>
  </view>

  <empty-state
    wx:if="{{!loading && list.length === 0}}"
    statusText="暂无匹配服务"
    title="当前分类暂无服务"
    description="可以切换到全部分类查看，或稍后再试。"
  />
</view>
