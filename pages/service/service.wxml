<view class="page service-hall-page {{themeClass}}">

  <view class="service-hero">
    <view class="service-hero__title">校园服务</view>
    <view class="service-hero__chips">
      <view class="service-hero__chip">
        <view class="service-hero__chip-icon service-hero__chip-icon--nav"></view>导航
      </view>
      <view class="service-hero__chip">
        <view class="service-hero__chip-icon service-hero__chip-icon--repair"></view>报修
      </view>
      <view class="service-hero__chip">
        <view class="service-hero__chip-icon service-hero__chip-icon--phone"></view>电话
      </view>
    </view>
    <view class="service-hero__stats">
      <view class="service-hero__stat">
        <text class="service-hero__stat-num">{{list.length}}</text>
        <text class="service-hero__stat-label">服务</text>
      </view>
      <view class="service-hero__stat">
        <text class="service-hero__stat-num">{{quickList.length}}</text>
        <text class="service-hero__stat-label">常用</text>
      </view>
      <view class="service-hero__stat">
        <text class="service-hero__stat-num">{{urgentList.length}}</text>
        <text class="service-hero__stat-label">紧急</text>
      </view>
    </view>
  </view>

  <view class="ticket-bar">
    <view class="ticket-bar__main">
      <view class="ticket-bar__icon-dot"></view>
      <view class="ticket-bar__info">
        <view class="ticket-bar__label">咨询报修</view>
        <view class="ticket-bar__status">工作日 8:00-18:00</view>
      </view>
    </view>
    <view class="ticket-bar__actions">
      <view class="ticket-bar__action ticket-bar__action--primary" bindtap="openConsultEntry">咨询</view>
      <view class="ticket-bar__action ticket-bar__action--outline" data-scene="repair" bindtap="openSurvivalRoute">报修</view>
      <view class="ticket-bar__action ticket-bar__action--ghost" bindtap="openTicketProgress">进度</view>
    </view>
  </view>

  <view class="service-promise">
    <view class="service-promise__item">
      <view class="service-promise__icon">
        <view class="service-promise__icon-pin"></view>
      </view>
      <text class="service-promise__label">去哪办</text>
      <text class="service-promise__value">关联地点</text>
    </view>
    <view class="service-promise__item">
      <view class="service-promise__icon">
        <view class="service-promise__icon-clipboard"></view>
      </view>
      <text class="service-promise__label">带什么</text>
      <text class="service-promise__value">材料清单</text>
    </view>
    <view class="service-promise__item">
      <view class="service-promise__icon">
        <view class="service-promise__icon-phone"></view>
      </view>
      <text class="service-promise__label">联系谁</text>
      <text class="service-promise__value">电话直达</text>
    </view>
  </view>

  <view class="issue-solver" wx:if="{{issueTabs.length}}">
    <view class="issue-solver__head">
      <view>
        <view class="issue-solver__label">常见问题</view>
      </view>
      <view class="issue-solver__count">{{issueTabs.length}} 类</view>
    </view>
    <scroll-view class="issue-tabs" scroll-x enable-flex>
      <view
        wx:for="{{issueTabs}}"
        wx:key="id"
        class="issue-tab {{currentIssueId === item.id ? 'issue-tab--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectIssue"
      >
        <view class="issue-tab__question">{{item.question}}</view>
        <view class="issue-tab__title">{{item.title}}</view>
      </view>
    </scroll-view>
    <view class="issue-panel" wx:if="{{currentIssue}}">
      <view class="issue-panel__intro">
        <view class="issue-panel__title">{{currentIssue.title}}</view>
        <view class="issue-panel__desc">{{currentIssue.desc}}</view>
      </view>
      <view class="issue-panel__list">
        <view
          wx:for="{{issueServices}}"
          wx:key="id"
          class="issue-service"
          data-place-id="{{item.primaryPlaceId}}"
          bindtap="openServicePlace"
        >
          <view class="issue-service__main">
            <view class="issue-service__tag">{{item.category}} / {{item.tag}}</view>
            <view class="issue-service__title">{{item.title}}</view>
            <view class="issue-service__desc">{{item.content}}</view>
            <view class="issue-service__meta">{{item.location}} · {{item.time}}</view>
          </view>
          <view class="issue-service__actions">
            <view class="issue-service__action">{{item.primaryPlaceName || item.actionText}}</view>
            <view class="issue-service__phone" data-phone="{{item.phone}}" catchtap="callServicePhone">拨打</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="service-alert" wx:if="{{urgentList.length}}">
    <view class="service-alert__head">
      <view>
        <view class="service-alert__label">
          <view class="service-alert__label-dot"></view>安全应急
        </view>
      </view>
      <view class="service-alert__count">{{urgentList.length}} 项</view>
    </view>
    <view class="service-alert__list">
      <view
        class="service-alert-row"
        wx:for="{{urgentList}}"
        wx:key="id"
        data-place-id="{{item.primaryPlaceId}}"
        bindtap="openServicePlace"
      >
        <view class="service-alert-row__main">
          <view class="service-alert-row__name">{{item.title}}</view>
          <view class="service-alert-row__meta">{{item.time}}</view>
        </view>
        <view class="service-alert-row__actions">
          <view class="service-alert-row__action">{{item.actionText}}</view>
          <view class="service-alert-row__phone" data-phone="{{item.phone}}" catchtap="callServicePhone">拨打</view>
        </view>
      </view>
    </view>
  </view>

  <view class="type-scroll">
    <scroll-view class="filter-scroll" scroll-x>
      <view
        wx:for="{{categoryTabs}}"
        wx:key="*this"
        class="type-pill {{currentCategory === item ? 'type-pill--active' : ''}}"
        data-category="{{item}}"
        bindtap="selectCategory"
      >
        {{item}}
      </view>
    </scroll-view>
  </view>

  <view class="panel-grid">
    <view class="service-group" wx:for="{{serviceGroups}}" wx:key="title">
      <view class="service-group__head">
        <view class="service-group__title">{{item.title}}</view>
        <view class="service-group__count">{{item.items.length}} 项</view>
      </view>
      <view
        class="service-row {{expandedItems['s_' + item.id] ? 'service-row--expanded' : ''}}"
        wx:for="{{item.items}}"
        wx:key="id"
        data-sid="{{item.id}}"
        bindtap="toggleServiceItem"
      >
        <view class="service-row__main">
          <view class="service-row__head">
            <view class="service-row__title">{{item.title}}</view>
            <text class="service-row__tag">{{item.tag}}</text>
          </view>
          <view class="service-row__summary" wx:if="{{!expandedItems['s_' + item.id]}}">
            <text class="service-row__loc-pin"></text>
            <text class="service-row__loc">{{item.location}}</text>
            <view class="service-row__expand-hint">详情</view>
          </view>
          <view class="service-row__detail" wx:if="{{expandedItems['s_' + item.id]}}">
            <view class="service-row__meta">{{item.location}} · {{item.time}}</view>
            <view class="service-row__materials" wx:if="{{item.materials.length}}">{{item.materials.join('、')}}</view>
            <view class="service-row__actions-inline">
              <view class="service-row__action" catchtap="openServicePlace" data-place-id="{{item.primaryPlaceId}}">{{item.primaryPlaceName || item.actionText}}</view>
              <view class="service-row__call" data-phone="{{item.phone}}" catchtap="callServicePhone">拨打</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <empty-state
    wx:if="{{!loading && list.length === 0}}"
    statusText="暂无匹配服务"
    title="当前分类暂无服务"
    description="切换分类后再试"
  />

  <view class="skeleton-shell" wx:if="{{loading}}">
    <view class="skeleton-hero">
      <view class="skeleton-line skeleton-line--w50"></view>
      <view class="skeleton-line skeleton-line--w80"></view>
      <view class="skeleton-line skeleton-line--w40"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line skeleton-line--w60"></view>
      <view class="skeleton-line skeleton-line--w100"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line skeleton-line--w70"></view>
      <view class="skeleton-line skeleton-line--w90"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line skeleton-line--w50"></view>
      <view class="skeleton-line skeleton-line--w80"></view>
    </view>
  </view>
</view>
