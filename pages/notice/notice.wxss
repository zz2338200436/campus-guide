.notice-toolbar {
  margin: 8rpx 0 18rpx;
  padding: 0 2rpx;
}

.notice-toolbar__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.notice-toolbar__meta text {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #475569;
}

.notice-section {
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.notice-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0 18rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.notice-section__label {
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.notice-section__title {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.notice-section__count {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .notice-section {
    padding: 0 20rpx;
  }

  .notice-section__title {
    font-size: 28rpx;
  }
}
