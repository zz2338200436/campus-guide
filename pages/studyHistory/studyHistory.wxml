<view class="page {{themeClass}}">
  <view class="page-head page-head--compact">
    <view class="page-head__eyebrow">Learning History</view>
    <view class="page-head__title">学习记录</view>
    <view class="page-head__desc">把最近学习过的内容整理成一条可回看的学习旅程。</view>
  </view>

  <view class="board-card" wx:if="{{isLogin}}">
    <view class="card-title">学习旅程</view>
    <view class="card-desc">每次打开学习详情都会自动写入这里，方便你从最近一次继续，或者回看某个阶段已经学过什么。</view>
  </view>

  <view class="panel-grid">
    <view class="history-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="history-card__title">{{item.title}}</view>
      <view class="history-card__meta">{{item.category}}</view>
      <view class="history-card__time">最近浏览：{{item.time}}</view>
    </view>
  </view>

  <empty-state
    wx:if="{{!isLogin}}"
    statusText="账号未登录"
    title="请先登录"
    description="登录后才能查看学习记录"
    buttonText="去登录"
    url="/pages/user/user"
  />

  <empty-state
    wx:if="{{isLogin && !loading && list.length === 0}}"
    statusText="暂无学习记录"
    title="暂无学习记录"
    description="打开学习详情页后会自动写入浏览记录"
  />
</view>
