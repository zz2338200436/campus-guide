.history-card {
  padding: 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.history-card__title {
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-card__meta {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-top: 12rpx;
  padding: 0 10rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #0369a1;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.history-card__time {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.4;
}
