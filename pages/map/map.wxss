.atlas-card,
.directory-card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}
.map-overview {
  display: flex; align-items: center; justify-content: space-between; gap: 18rpx;
  margin-bottom: 16rpx; padding: 18rpx 20rpx; border: 1rpx solid #e5e7eb; border-radius: 8rpx;
  background: #ffffff; box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}
.map-overview__main { flex: 1; min-width: 0; }
.map-overview__title { color: #0f172a; font-size: 30rpx; font-weight: 800; line-height: 1.3; }
.map-overview__desc { margin-top: 4rpx; color: #64748b; font-size: 21rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.map-overview__count { flex-shrink: 0; min-height: 40rpx; padding: 0 12rpx; border-radius: 8rpx; background: #eff6ff; color: #0369a1; font-size: 21rpx; font-weight: 800; line-height: 40rpx; }
.guide-hint { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 16rpx; }
.guide-hint__item { min-height: 76rpx; padding: 14rpx 16rpx; border: 1rpx solid #dbeafe; border-radius: 8rpx; background: #f8fafc; }
.guide-hint__label { display: block; color: #0369a1; font-size: 21rpx; font-weight: 800; line-height: 1.3; }
.guide-hint__value { display: block; margin-top: 6rpx; color: #475569; font-size: 21rpx; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.atlas-card { padding: 22rpx; }
.zone-strip {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  margin-top: 18rpx;
  margin-bottom: 0;
  padding-bottom: 2rpx;
  white-space: nowrap;
}
.zone-chip {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
  height: 48rpx;
  padding: 0 14rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #0f172a;
}
.zone-chip__count {
  color: #0369a1;
  font-size: 23rpx;
  font-weight: 800;
}
.zone-chip__title {
  max-width: 148rpx;
  font-size: 22rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.selected-place__meta,
.nav-info-panel__address,
.nav-info-panel__hint,
.location-panel__status {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}
.selected-place__meta,
.nav-info-panel__address {
  -webkit-line-clamp: 2;
}
.atlas-card__filters { margin: 16rpx 0 18rpx; }
.trust-filter {
  display: inline-flex; align-items: center; height: 58rpx; margin-left: 10rpx; padding: 0 18rpx;
  border: 1rpx solid #fed7aa; border-radius: 8rpx; background: #fff7ed; color: #9a3412;
  font-size: 23rpx; font-weight: 800;
}
.trust-filter--active { background: #9a3412; color: #ffffff; }
.search-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}
.search-card__main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-card__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 25rpx;
}
.search-card__button {
  flex-shrink: 0;
  min-width: 100rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: #0369a1;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}
.search-card__clear { flex-shrink: 0; color: #0369a1; font-size: 22rpx; font-weight: 800; }
.emergency-strip {
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #fee2e2;
  border-radius: 8rpx;
  background: #fff7ed;
}
.emergency-strip__head,
.map-stage__head,
.nav-info-panel__header,
.directory-item__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}
.emergency-strip__title {
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 800;
}
.emergency-strip__action {
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 800;
}
.emergency-chip-row { margin-top: 12rpx; white-space: nowrap; }
.emergency-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 260rpx;
  height: 46rpx;
  margin-right: 10rpx;
  padding: 0 12rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 8rpx;
  background: #ffffff;
}
.emergency-chip__name {
  min-width: 0;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.emergency-chip__type {
  flex-shrink: 0;
  color: #9a3412;
  font-size: 19rpx;
}
.map-stage {
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}
.map-stage__head {
  border-top: 1rpx solid #e5e7eb;
  padding: 20rpx 20rpx 16rpx;
}
.map-stage__summary { flex: 1; min-width: 0; }
.map-stage__tools { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex-shrink: 0; }
.map-stage__title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}
.map-stage__count {
  flex-shrink: 0;
  min-height: 42rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}
.map-layer-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.map-layer-summary text {
  min-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 34rpx;
}
.map-mode-bar {
  display: flex;
  gap: 6rpx;
}
.map-mode {
  min-width: 72rpx;
  height: 44rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}
.map-mode--active { border-color: #0369a1; background: #0369a1; color: #ffffff; }
.campus-real-map {
  display: block;
  width: 100%;
  height: 520rpx;
  background: #f1f5f9;
}
.campus-real-map--navigating {
  height: 620rpx;
}
.selected-place {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 14rpx;
  margin: 0 20rpx 20rpx;
  padding: 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}
.selected-place__label,
.nav-info-panel__label {
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 800;
}
.selected-place__title,
.nav-info-panel__name {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}
.selected-place__trust,
.nav-info-panel__trust,
.directory-item__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.selected-place__trust text,
.nav-info-panel__trust text,
.directory-item__trust text {
  min-height: 32rpx;
  max-width: 190rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #0369a1;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.selected-place__trust--review text,
.nav-info-panel__trust--review text,
.directory-item__trust--review text {
  background: #ffedd5;
  color: #9a3412;
}
.nav-info-panel__actions,
.directory-item__actions {
  display: grid;
  gap: 8rpx;
}
.selected-place__actions { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 10rpx; flex-shrink: 0; }
.selected-place__primary-actions { display: flex; align-items: center; gap: 8rpx; }
.selected-place__secondary-actions { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; max-width: 220rpx; flex-wrap: wrap; }
.selected-place__btn,
.selected-place__review {
  min-width: 132rpx;
  height: 50rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 50rpx;
  text-align: center;
}
.selected-place__btn {
  background: #0369a1;
  color: #ffffff;
}
.selected-place__review {
  border: 1rpx solid #fed7aa;
  background: #fff7ed;
  color: #9a3412;
}
.selected-place__link { color: #0369a1; font-size: 21rpx; font-weight: 800; line-height: 1.35; }
.nav-info-panel {
  margin: 0 20rpx 20rpx;
  padding: 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}
.nav-info-panel__dest {
  flex: 1;
  min-width: 0;
}
.nav-info-panel__distance {
  flex-shrink: 0;
  min-width: 120rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  text-align: center;
}
.nav-info-panel__distance-num {
  display: block;
  color: #0369a1;
  font-size: 30rpx;
  font-weight: 800;
}
.nav-info-panel__distance-label {
  display: block;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
}
.nav-info-panel__actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; }
.nav-info-panel__primary-actions { flex: 1; min-width: 0; }
.nav-info-panel__secondary-actions { display: flex; align-items: center; justify-content: flex-end; gap: 18rpx; flex-shrink: 0; }
.nav-info-panel__btn { width: 100%; }
.nav-info-panel__link { color: #0369a1; font-size: 22rpx; font-weight: 800; line-height: 1.4; }
.nav-info-panel__link--danger { color: #9a3412; }
.nav-info-panel__hint {
  margin-top: 12rpx;
  -webkit-line-clamp: 2;
}
.location-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 20rpx 18rpx;
  border-top: 1rpx solid #e5e7eb;
}
.location-toolbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.location-action {
  height: 44rpx;
  padding: 0 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #0369a1;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}
.location-panel__status { flex: 1; min-width: 0; -webkit-line-clamp: 1; }
.directory-card {
  padding: 4rpx 20rpx;
}
.directory-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e5e7eb;
}
.directory-item:first-child {
  border-top: 0;
}
.directory-item__index {
  flex-shrink: 0;
  width: 48rpx;
  color: #0369a1;
  font-size: 24rpx;
  font-weight: 800;
}
.directory-item__body {
  flex: 1;
  min-width: 0;
}
.directory-item__title {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.directory-item__tag {
  flex-shrink: 0;
  min-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 20rpx;
  line-height: 36rpx;
}
.directory-item__locate,
.directory-item__nav {
  min-width: 104rpx;
  height: 52rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
}
.directory-item__locate {
  border: 1rpx solid #bae6fd;
  background: #f0f9ff;
  color: #0369a1;
}
.directory-item__nav {
  background: #0369a1;
  color: #ffffff;
}
.directory-item__review {
  min-width: 104rpx; height: 48rpx; border: 1rpx solid #fed7aa; border-radius: 8rpx;
  background: #fff7ed; color: #9a3412; font-size: 21rpx; font-weight: 800; line-height: 48rpx; text-align: center;
}
.directory-item__source { max-width: 210rpx; }
.directory-item__status { max-width: 130rpx; }
@media (max-width: 360px) {
  .atlas-card,
  .map-stage__head,
  .location-panel,
  .directory-card {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }
  .selected-place,
  .nav-info-panel__header,
  .directory-item {
    align-items: stretch;
    flex-direction: column;
  }
  .selected-place__actions,
  .directory-item__actions {
    grid-template-columns: 1fr;
  }
  .location-panel {
    align-items: stretch;
    flex-direction: column;
  }
  .location-toolbar {
    justify-content: flex-start;
    flex-wrap: wrap;
  }
  .campus-real-map,
  .campus-real-map--navigating {
    height: 500rpx;
  }
}
