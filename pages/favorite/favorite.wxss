.page {
  padding-bottom: 184rpx;
}

.tab-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 18rpx;
  padding: 8rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.tab-row__item {
  height: 64rpx;
  border-radius: 8rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.tab-row__item--active {
  background: #0f766e;
  color: #ffffff;
}

.fav-card {
  padding: 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.fav-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.fav-card__title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.fav-card__summary {
  margin-top: 10rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.fav-card__time {
  margin-top: 12rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.4;
}
