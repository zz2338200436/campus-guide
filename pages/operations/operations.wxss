.page {
  padding-bottom: 184rpx;
}

.operations-page {
  background: #f7f9fb;
}

.operations-hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 20rpx;
  background: #1f2937;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.14);
}

.operations-hero__eyebrow {
  color: #99f6e4;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.operations-hero__title {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.24;
}

.operations-hero__desc {
  margin-top: 14rpx;
  color: #cbd5e1;
  font-size: 25rpx;
  line-height: 1.62;
}

.operations-grid,
.quality-grid,
.place-quality-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.operations-kpi-note {
  margin: -6rpx 0 16rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.5;
}

.operations-stat,
.quality-card,
.place-quality-card {
  min-height: 150rpx;
  padding: 22rpx;
}

.operations-stat__value,
.quality-card__value,
.place-quality-card__value {
  color: #0f766e;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.operations-stat__label,
.quality-card__label,
.place-quality-card__label {
  margin-top: 8rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.35;
}

.operations-stat__desc,
.quality-card__desc,
.place-quality-card__desc {
  margin-top: 6rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.45;
}

.operations-panel,
.operations-denied {
  margin-top: 24rpx;
  padding: 26rpx;
}

.operations-panel__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.operations-panel__label {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.operations-panel__title,
.operations-denied__title {
  margin-top: 10rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.42;
}

.operations-panel__badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.quality-grid,
.place-quality-grid,
.hot-place-list,
.health-list,
.suggestion-list {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.quality-card,
.place-quality-card,
.hot-place,
.health-item,
.suggestion-item,
.health-empty {
  background: #f7f9fb;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

.place-quality-grid {
  margin-top: 18rpx;
}

.place-quality-card {
  min-height: 128rpx;
}

.coordinate-review-summary,
.coordinate-review-list {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.coordinate-review-summary {
  padding: 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
}

.coordinate-review-summary__head,
.coordinate-review-head,
.coordinate-review-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.coordinate-review-summary__label,
.coordinate-review-head {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}
.coordinate-review-summary__title {
  margin-top: 6rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 850;
}
.coordinate-review-summary__count {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}
.coordinate-review-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}
.coordinate-review-metric {
  padding: 14rpx;
  border: 1rpx solid #bbf7d0;
  border-radius: 12rpx;
  background: #ecfdf5;
}
.coordinate-review-metric__value {
  color: #0f766e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}
.coordinate-review-metric__label {
  margin-top: 4rpx;
  color: #475569;
  font-size: 24rpx;
}
.coordinate-review-metric--warning {
  border-color: #fed7aa;
  background: #fff7ed;
}
.coordinate-review-metric--warning .coordinate-review-metric__value {
  color: #9a3412;
}
.coordinate-review-ready {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}
.coordinate-review-ready text {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: #ccfbf1;
}
.coordinate-review-ready__item {
  box-shadow: inset 0 0 0 1rpx #5eead4;
}
.coordinate-review-blocked {
  display: grid;
  gap: 8rpx;
  padding: 12rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 12rpx;
  background: #fff7ed;
}
.coordinate-review-blocked__title {
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 800;
}
.coordinate-review-blocked__state {
  display: block;
  margin-top: 4rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}
.coordinate-review-blocked__head,
.coordinate-review-blocked__summary {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.coordinate-review-blocked__head {
  justify-content: space-between;
}
.coordinate-review-blocked__item {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #7c2d12;
  font-size: 24rpx;
  line-height: 1.4;
}
.coordinate-review-blocked__item text:first-child {
  display: block;
  color: #1f2937;
  font-weight: 800;
}
.coordinate-review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 8rpx;
}
.coordinate-review-tag {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.coordinate-review-tag--danger {
  background: #fee2e2;
  color: #b91c1c;
}
.coordinate-review-tag--warning {
  background: #ffedd5;
  color: #9a3412;
}
.coordinate-review-tag--info {
  background: #bbf7d0;
  color: #0f766e;
}
.coordinate-review-tag--reset {
  background: #fff;
  color: #475569;
}
.coordinate-review-tag--active {
  box-shadow: inset 0 0 0 2rpx currentColor;
}
.coordinate-review-blocked__item > text {
  flex-shrink: 0;
  color: #0f766e;
  font-weight: 800;
}
.coordinate-review-workflow {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}
.coordinate-review-step {
  min-width: 0;
  padding: 12rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  background: #f7f9fb;
}
.coordinate-review-step text,
.coordinate-review-copy {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coordinate-review-step text {
  color: #475569;
  font-size: 24rpx;
  font-weight: 800;
}
.coordinate-review-copy {
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.coordinate-review-head {
  font-size: 24rpx;
}
.coordinate-review-head text:last-child {
  flex-shrink: 0;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}
.coordinate-review-step:last-child .coordinate-review-copy {
  color: #9a3412;
}

.coordinate-review-row {
  padding: 14rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #f7f9fb;
}

.coordinate-review-row__name {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 850;
}

.coordinate-review-row__note {
  margin-top: 4rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.45;
}

.coordinate-review-row__status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 800;
}

.hot-place,
.health-item,
.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx;
}

.hot-place {
  align-items: center;
  justify-content: space-between;
}

.hot-place__name,
.health-item__title {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.45;
}

.hot-place__meta,
.health-item__desc,
.operations-denied__desc,
.suggestion-item__text,
.health-empty {
  margin-top: 6rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.58;
}

.hot-place__score {
  flex-shrink: 0;
  min-width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.health-item__level {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.health-item__level--danger {
  background: #fef2f2;
  color: #b91c1c;
}

.health-item__body {
  flex: 1;
  min-width: 0;
}

.health-item__action {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.health-empty {
  margin-top: 18rpx;
  padding: 18rpx;
}

.suggestion-item__dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #0f766e;
  box-shadow: 0 0 0 8rpx rgba(3, 105, 161, 0.08);
}

.operations-denied__btn {
  margin-top: 24rpx;
}
