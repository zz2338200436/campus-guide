<view class="page {{themeClass}}">
  <view class="assistant-shell">
    <scroll-view class="assistant-messages" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}">
      <view class="assistant-hero">
        <view class="assistant-hero__title">校园助手</view>
        <view class="assistant-hero__desc">问地点、服务、校园圈</view>
        <view class="assistant-hero__hint" wx:if="{{connectionHint}}">{{connectionHint}}</view>
      </view>
      <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="assistant-message assistant-message--{{item.role}}">
        <text>{{item.content}}</text>
      </view>
      <view wx:if="{{pending}}" class="assistant-message assistant-message--assistant assistant-message--pending">
        <text>{{statusText}}</text>
      </view>
    </scroll-view>

    <scroll-view class="assistant-quick" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="assistant-quick__row">
        <text wx:for="{{quickQuestions}}" wx:key="*this" class="assistant-quick__item" data-question="{{item}}" bindtap="sendQuick">{{item}}</text>
      </view>
    </scroll-view>

    <view class="assistant-bar">
      <input class="assistant-bar__input" placeholder="问地点、问服务、问校园圈" value="{{inputText}}" bindinput="handleInput" bindconfirm="sendMessage" disabled="{{pending}}" />
      <text wx:if="{{!canCancel}}" class="assistant-bar__send {{pending ? 'assistant-bar__send--disabled' : ''}}" bindtap="sendMessage">{{pending ? '...' : '发送'}}</text>
      <text wx:if="{{canCancel}}" class="assistant-bar__cancel" bindtap="cancelRequest">取消</text>
    </view>
  </view>
</view>
