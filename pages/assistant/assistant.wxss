/* ── 整体页面 ── */
.page {
  height: 100vh;
  padding-bottom: 0;
  background: #f0f2f5;
}

.chat-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}

/* ── 消息滚动区 ── */
.chat-messages {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx;
}

/* ── 欢迎区域 ── */
.chat-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.chat-hero__icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6, #0f766e);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.3);
}

.chat-hero__title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.chat-hero__desc {
  color: #94a3b8;
  font-size: 26rpx;
  line-height: 1.5;
}

.chat-hero__hint {
  margin-top: 16rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
}

/* ── 消息行（始终 LTR，用 spacer 占位替代 row-reverse）── */
.chat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

/* ── 侧边占位 ── */
.chat-side {
  width: 72rpx;
  flex-shrink: 0;
}

.chat-side--spacer {
  height: 1rpx;
  opacity: 0;
}

/* ── 头像 ── */
.chat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.chat-avatar--assistant {
  background: linear-gradient(135deg, #14b8a6, #0f766e);
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.25);
}

.chat-avatar--user {
  background: linear-gradient(135deg, #0f766e, #115e59);
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.25);
}

/* ── 气泡外层 ── */
.chat-bubble-wrapper {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 160rpx);
  min-width: 0;
}

.chat-bubble-wrapper--user {
  align-items: flex-end;
  margin-left: auto;
}

.chat-bubble-wrapper--assistant {
  align-items: flex-start;
  margin-right: auto;
}

/* ── 消息气泡 ── */
.chat-bubble {
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  position: relative;
}

.chat-bubble--assistant {
  background: #ffffff;
  color: #1e293b;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.chat-bubble--user {
  background: linear-gradient(135deg, #14b8a6, #0f766e);
  color: #ffffff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 118, 110, 0.25);
}

.chat-bubble--thinking {
  min-width: 40%;
}

/* ── 思考中文本 ── */
.thinking-text {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.thinking-dots {
  display: inline-block;
  animation: dotPulse 1.4s steps(4, end) infinite;
  overflow: hidden;
  vertical-align: bottom;
  width: 1.2em;
}

@keyframes dotPulse {
  0%   { width: 0; }
  25%  { width: 0.3em; }
  50%  { width: 0.7em; }
  75%  { width: 1.0em; }
  100% { width: 1.2em; }
}

/* ── 时间戳 ── */
.chat-time {
  font-size: 22rpx;
  color: #b0b8c1;
  margin-top: 8rpx;
  padding: 0 8rpx;
}

/* ── 打字机输出 ── */
.streaming-answer {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1e293b;
  white-space: pre-wrap;
  word-break: break-all;
}

.streaming-cursor {
  display: inline;
  color: #0f766e;
  font-weight: 400;
  animation: cursorBlink 0.8s step-end infinite;
}

@keyframes cursorBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* ── 快捷问题 ── */
.chat-quick {
  flex-shrink: 0;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.chat-quick__row {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
}

.chat-quick__item {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 32rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.chat-quick__item:active {
  background: #ecfdf5;
  border-color: #14b8a6;
}

/* ── 输入栏 ── */
.chat-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e8eaed;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chat-bar__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 26rpx;
}

.chat-bar__send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6, #0f766e);
  color: #ffffff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.3);
}

.chat-bar__send--disabled {
  background: #cbd5e1;
  box-shadow: none;
}

.chat-bar__cancel {
  min-width: 88rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1rpx solid #fca5a5;
  background: #fef2f2;
  color: #dc2626;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.chat-bar__cancel:active {
  background: #fee2e2;
}
